# Generate real random values with npm run setup. Never commit .env.
AUTH_PASSWORD=
# 32 random bytes encoded in base64. Required to decrypt stored API credentials.
ENCRYPTION_KEY=
COLLECT_INTERVAL_MINUTES=60
# Set true when accessing through an HTTPS reverse proxy.
COOKIE_SECURE=false
PORT=3080
# CoinGecko price API (optional but recommended). Free demo key: https://www.coingecko.com/en/api
# COINGECKO_API_TYPE=demo uses x-cg-demo-api-key ; pro uses x-cg-pro-api-key and pro-api host.
COINGECKO_API_KEY=
COINGECKO_API_TYPE=demo
